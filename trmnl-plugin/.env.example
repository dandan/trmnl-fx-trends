# Copy to .env.<profile> and fill in. Git-ignored.
#
#   cp .env.example .env.prod
#   ./deploy.sh prod
#
# Profiles in use: qa (the clone on my device, polling the QA Worker), prod
# (the Recipe Master every installer runs), and one per other account.
# See docs/build_multi_deploy.md.

# That account's trmnlp key, from https://trmnl.com/account
TRMNL_API_KEY=

# That account's plugin ID, from the dashboard URL /plugin_settings/<ID>/edit.
# Filled in automatically by `./deploy.sh <profile> --create`. deploy.sh refuses
# to push without it: trmnlp would silently create a brand new plugin instead of
# updating the intended one.
TRMNL_PLUGIN_ID=

# The Worker host this plugin instance polls. The committed settings.yml carries
# the production host, which is what the published recipe ships; deploy.sh
# swaps in this value for the upload only. Required — a profile without it
# could push the production host to the QA clone without anyone noticing.
#   exchange-rates-trmnl.uezi.workers.dev       production
#   exchange-rates-trmnl-qa.uezi.workers.dev    QA
WORKER_HOST=

# Optional. Appended to the plugin's name for the upload only, so the QA clone
# stays telling apart from the Recipe Master in the dashboard, where both would
# otherwise be "Exchange Rates - Sparklines". Leave unset on prod and on other
# accounts' profiles. Quote it: the value starts with a space.
#   PLUGIN_NAME_SUFFIX=" (QA)"
PLUGIN_NAME_SUFFIX=
