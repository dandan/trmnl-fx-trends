# Copy to .env.<profile> (e.g. .env.personal) and fill in. Git-ignored.
#
#   cp .env.example .env.personal
#   ./deploy.sh personal

# That account's trmnlp key, from https://trmnl.com/account
TRMNL_API_KEY=

# That account's plugin ID, from the dashboard URL /plugin_settings/<ID>/edit.
# Filled in automatically by `./deploy.sh <profile> --create`. deploy.sh refuses
# to push without it: trmnlp would silently create a brand new plugin instead of
# updating the intended one.
TRMNL_PLUGIN_ID=
