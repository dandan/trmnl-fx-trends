#!/usr/bin/env ruby
# frozen_string_literal: true
#
# `trmnlp`, with Selenium pointed at Ubuntu's snap Firefox. Use it in place of
# the real command when rendering dies with "binary is not a Firefox executable":
#
#   ./trmnlp-snap serve
#   ./trmnlp-snap build
#
# On Ubuntu /usr/bin/firefox is a /bin/sh wrapper around the snap. Selenium
# Manager reports that wrapper as the browser path, geckodriver rejects it for
# not being an executable image, and every screenshot fails. trmnlp builds its
# own Firefox::Options and exposes no hook for the binary path (Firefox.path is
# too late — DriverFinder has already filled options.binary in by then), so
# default Options to the real ELF inside the snap.
#
# Activating the gem first keeps its own dependency constraints in force; a bare
# `require "selenium-webdriver"` would resolve them the wrong way round and take
# newer gems than trmnlp allows.
gem "trmnl_preview"
require "selenium-webdriver"

SNAP_FIREFOX = "/snap/firefox/current/usr/lib/firefox/firefox"

# A real (non-snap) Firefox needs no help.
if File.executable?(SNAP_FIREFOX) &&
   File.exist?("/usr/bin/firefox") && File.read("/usr/bin/firefox", 2) == "#!"
  module Selenium
    module WebDriver
      module Firefox
        class Options
          alias_method :initialize_without_snap_binary, :initialize
          def initialize(**opts)
            opts[:binary] ||= SNAP_FIREFOX
            initialize_without_snap_binary(**opts)
          end
        end
      end
    end
  end
end

load Gem.bin_path("trmnl_preview", "trmnlp")
