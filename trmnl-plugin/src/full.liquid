{% comment %}
  Full view — 800x480. Six pair rows with sparklines.
  Merge variables come from the Worker's /rates response.
{% endcomment %}

<style>
  {% comment %}
    TREND takes the free width (1fr) and HI / LO sizes to its content (auto).
    The reverse — a fixed sparkline with 1fr on the bounds — left ~119px of
    empty space inside the last cell, stranding the numbers at the far edge.
  {% endcomment %}
  .fx--full .fx-row,
  .fx--full .fx-head { grid-template-columns: 112px minmax(148px, auto) 92px 1fr auto; gap: 16px; }
  {% comment %} 15px pads 6 rows out to fill the panel above the title_bar. {% endcomment %}
  .fx--full .fx-row  { padding: 15px 0; }
  .fx--full .fx-pair { font-size: 19px; }
  .fx--full .fx-rate { font-size: 23px; }
  .fx--full .fx-chg  { font-size: 14px; }
  .fx--full .fx-range{ font-size: 12px; }
  {% comment %} 11:1 is the shape the design was tuned to on TRMNL OG. {% endcomment %}
  {% comment %} 6 rows, ~82px of header+title_bar chrome, 31px row padding. {% endcomment %}
  .fx--full .fx-spark svg { height: calc((var(--screen-h) - 82px) / 6 - 31px); }
</style>

<div class="layout layout--col layout--justify-start">
  {% if fx_failed %}
    <div class="fx-error">
      <span class="title">Rates unavailable</span>
      <span class="label label--gray-out" style="margin-top:6px;">
        {{ error | default: "No data returned" }}
      </span>
    </div>
  {% else %}
    <div class="fx-list fx--full">
      <div class="fx-head">
        <span></span><span>LATEST</span><span>CHANGE</span><span>TREND</span><span>HI / LO</span>
      </div>

      {% for row in rows limit: 6 %}
        <div class="fx-row">
          <div class="fx-pair">{{ row.from }}<span class="fx-arrow">&rarr;</span>{{ row.to }}</div>
            <div class="fx-rate">{{ row.rate_str }}</div>
          <div class="fx-chg">
            {% if row.change_pct >= 0 %}&#9650;{% else %}&#9660;{% endif %}
            {{ row.change_pct | abs }}%
          </div>
          <div class="fx-spark">
            {% comment %} Endpoint marker: last coordinate of the polyline. {% endcomment %}
            {%- assign fx_xy = row.points | split: " " | last | split: "," -%}
            <svg viewBox="0 0 200 30" width="100%" height="30" preserveAspectRatio="none">
              <polyline points="{{ row.points }}" vector-effect="non-scaling-stroke"/>
              <line x1="{{ fx_xy[0] }}" y1="{{ fx_xy[1] | minus: 3 }}" x2="{{ fx_xy[0] }}" y2="{{ fx_xy[1] | plus: 3 }}" vector-effect="non-scaling-stroke"/>
            </svg>
          </div>
          <div class="fx-range"><span>{{ row.hi }}</span><span>{{ row.lo }}</span></div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

{% comment %}
  Full view: .title_bar comes AFTER .layout. TRMNL's
  `.view--full .layout:has(+.title_bar)` rule reserves the height and adds the
  gap only when the bar is the layout's next sibling.
{% endcomment %}
<div class="title_bar">
  <span class="title">Exchange Rates</span>
  <span class="instance">
    {% comment %}
      The window leads, because it governs three of the four columns — the
      change figure, the sparkline and lo/hi are all measured over it. Stating
      it once here is what keeps CHANGE from being read as a daily move.
    {% endcomment %}
    {% if fx_failed %}No data{% else %}{{ range_label }} &middot; {{ rows | size }} pairs &middot; ECB {{ as_of }}{% endif %}
  </span>
</div>
