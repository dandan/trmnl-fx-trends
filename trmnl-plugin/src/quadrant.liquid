{% comment %}
  Quadrant — 400x240. Same shape as half_vertical (pair, rate, change, trend,
  no HI/LO) but three rows instead of six, since the panel is half the height.

  Earlier this view showed no sparkline at all, on the reasoning that a trace
  this small was noise. With the row layout borrowed from half_vertical it earns
  its place: the trend is the column that survives shrinking best, because it
  carries shape rather than digits.
{% endcomment %}

{% comment %} Row inset is py--2 (8px) on the row: 9px would not step. {% endcomment %}
{% comment %}
  Half the panel height, 3 rows, 17px of row inset (2 x 8 + rule). No cap (see
  half_vertical), so the 75px chrome constant is what sets the fit: it is the
  header, its rule and the compact title bar, measured so three rows end 1px
  above the bar on OG. The old 70px only ever fitted because the cap hid it.
{% endcomment %}
<style>
  .fx--quad .fx-row,
  .fx--quad .fx-head { grid-template-columns: 88px minmax(66px, auto) 50px 1fr; gap: 7px; }
  .fx--quad { --fx-top-pad: 8px; --fx-pair: 13px; --fx-rate: 15px; --fx-chg: 10px; --fx-head: 10px; }
  .fx--quad .fx-dot  { r: 2.5px; }
  .fx--quad .fx-head { letter-spacing: 0.06em; }
  .fx--quad .fx-spark svg { height: calc((var(--screen-h) / 2 - 75px - var(--fx-top-pad)) / 3 - 17px); }
</style>

<div class="layout layout--col layout--justify-start">
  {% if fx_failed %}
    <div class="fx-error flex flex--col flex--center-y text--center">
      <span class="title">Rates unavailable</span>
    </div>
  {% else %}
    <div class="fx-list flex flex--col gap--none pt--2 fx--quad">
      <div class="fx-head grid pb--1">
        <span>PAIR</span><span class="text--right">LATEST</span><span class="text--right">CHANGE</span><span class="text--center">{% if range_label %}{{ range_label }} {% endif %}TREND</span>
      </div>

      {% for row in rows limit: 3 %}
        <div class="fx-row grid py--2">
          <div class="fx-pair">{{ row.from }}<span class="fx-arrow px--0.5">&rarr;</span>{{ row.to }}</div>
          <div class="fx-rate text--right">{{ row.rate_str }}</div>
          <div class="fx-chg flex flex--right gap--none"><span class="fx-pill inline-block rounded--xsmall py--1 px--1{% if row.change_pct < 0 %} fx-pill--down bg--black text--white{% endif %}">{{ row.change_str }}%</span></div>
          {% assign fx_end = row.points | split: " " | last | split: "," %}
          {% assign fx_end_y = fx_end[1] | times: 100.0 | divided_by: 30 %}
          <div class="fx-spark flex gap--none pr--1">
            <svg class="fx-plot block" width="100%" height="24">
              <svg class="block" viewBox="0 0 200 30" width="100%" height="100%" preserveAspectRatio="none">
                <polyline points="{{ row.points }}" vector-effect="non-scaling-stroke"/>
              </svg>
              <circle class="fx-dot" cx="100%" cy="{{ fx_end_y }}%"/>
            </svg>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<div class="title_bar">
  {{ fx_icon }}
  <span class="title">Exchange Rates{% if env %} ({{ env | upcase }}){% endif %}</span>
  <span class="instance">{% if fx_failed %}No data{% else %}<span class="fx-dates text--default">{{ fx_dates }}</span>{% endif %}</span>
</div>
