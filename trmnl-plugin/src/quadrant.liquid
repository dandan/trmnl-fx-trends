{% comment %}
  Quadrant — 400x240. Same shape as half_vertical (pair, rate, change, trend,
  no HI/LO) but three rows instead of six, since the panel is half the height.

  Earlier this view showed no sparkline at all, on the reasoning that a trace
  this small was noise. With the row layout borrowed from half_vertical it earns
  its place: the trend is the column that survives shrinking best, because it
  carries shape rather than digits.
{% endcomment %}

<style>
  .fx--quad .fx-row,
  .fx--quad .fx-head { grid-template-columns: 88px minmax(66px, auto) 50px 1fr; gap: 7px; }
  .fx--quad { --fx-top-pad: 8px; }
  .fx--quad .fx-row  { padding: 9px 0; }
  .fx--quad .fx-pair { font-size: 13px; }
  .fx--quad .fx-rate { font-size: 15px; }
  .fx--quad .fx-chg  { font-size: 10px; }
  .fx--quad .fx-pill { padding: 3px 4px; }
  .fx--quad .fx-dot  { width: 5px; height: 5px; }
  .fx--quad .fx-spark { padding-right: 3px; }
  .fx--quad .fx-head { font-size: 10px; letter-spacing: 0.06em; }
  {% comment %} Half the panel height, 3 rows, 19px row padding; capped like half_vertical. {% endcomment %}
  .fx--quad .fx-spark svg { height: calc((var(--screen-h) / 2 - 70px - var(--fx-top-pad)) / 3 - 19px);
                            max-height: calc(var(--screen-h) / 16); }
  {% comment %} Portrait: no cap, for the reason given in half_vertical. {% endcomment %}
  .screen--portrait .fx--quad .fx-spark svg { max-height: none; }
</style>

<div class="layout layout--col layout--justify-start">
  {% if fx_failed %}
    <div class="fx-error">
      <span class="title">Rates unavailable</span>
    </div>
  {% else %}
    <div class="fx-list fx--quad">
      <div class="fx-head">
        <span>PAIR</span><span>LATEST</span><span>CHANGE</span><span>{% if range_label %}{{ range_label }} {% endif %}TREND</span>
      </div>

      {% for row in rows limit: 3 %}
        <div class="fx-row">
          <div class="fx-pair">{{ row.from }}<span class="fx-arrow">&rarr;</span>{{ row.to }}</div>
          <div class="fx-rate">{{ row.rate_str }}</div>
          <div class="fx-chg"><span class="fx-pill rounded--xsmall{% if row.change_pct < 0 %} fx-pill--down bg--black text--white{% endif %}">{{ row.change_str }}%</span></div>
          {% assign fx_end = row.points | split: " " | last | split: "," %}
          {% assign fx_end_y = fx_end[1] | times: 100.0 | divided_by: 30 %}
          <div class="fx-spark">
            <div class="fx-plot">
              <svg viewBox="0 0 200 30" width="100%" height="24" preserveAspectRatio="none">
                <polyline points="{{ row.points }}" vector-effect="non-scaling-stroke"/>
              </svg>
              <span class="fx-dot" style="top: {{ fx_end_y }}%"></span>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<div class="title_bar">
  {{ fx_icon }}
  <span class="title">Exchange Rates{% if env %} ({{ env | upcase }}){% endif %}</span>
  <span class="instance">{% if fx_failed %}No data{% else %}<span class="fx-dates text--default">{{ fx_dates }}</span>{% endif %}</span>
</div>
