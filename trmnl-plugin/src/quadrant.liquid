{% comment %}
  Quadrant — 400x240. Same shape as half_vertical (pair, rate, change, trend,
  no HI/LO) but three rows instead of six, since the panel is half the height.

  Earlier this view showed no sparkline at all, on the reasoning that a trace
  this small was noise. With the row layout borrowed from half_vertical it earns
  its place: the trend is the column that survives shrinking best, because it
  carries shape rather than digits.
{% endcomment %}

<style>
  .fx--quad .fx-row,
  .fx--quad .fx-head { grid-template-columns: 88px minmax(76px, auto) 46px 1fr; gap: 7px; }
  .fx--quad .fx-row  { padding: 9px 0; }
  .fx--quad .fx-pair { font-size: 13px; }
  .fx--quad .fx-rate { font-size: 15px; }
  .fx--quad .fx-chg  { font-size: 10px; }
  .fx--quad .fx-head { font-size: 8px; letter-spacing: 0.08em; }
  {% comment %} Half the panel height, 3 rows, 19px row padding; capped like half_vertical. {% endcomment %}
  .fx--quad .fx-spark svg { height: calc((var(--screen-h) / 2 - 70px) / 3 - 19px);
                            max-height: calc(var(--screen-h) / 16); }
</style>

<div class="layout layout--col layout--justify-start">
  {% if fx_failed %}
    <div class="fx-error">
      <span class="title">Rates unavailable</span>
    </div>
  {% else %}
    <div class="fx-list fx--quad">
      <div class="fx-head">
        <span></span><span>LATEST</span><span>CHANGE</span><span>TREND</span>
      </div>

      {% for row in rows limit: 3 %}
        <div class="fx-row">
          <div class="fx-pair">{{ row.from }}<span class="fx-arrow">&rarr;</span>{{ row.to }}</div>
          <div class="fx-rate">{{ row.rate }}</div>
          <div class="fx-chg">
            {% if row.change_pct >= 0 %}&#9650;{% else %}&#9660;{% endif %}
            {{ row.change_pct | abs }}%
          </div>
          <div class="fx-spark">
            <svg viewBox="0 0 200 30" width="100%" height="24" preserveAspectRatio="none">
              <polyline points="{{ row.points }}" vector-effect="non-scaling-stroke"/>
            </svg>
          </div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Exchange Rates</span>
  <span class="instance">{% if fx_failed %}No data{% else %}{{ range_label }} &middot; {{ as_of }}{% endif %}</span>
</div>
