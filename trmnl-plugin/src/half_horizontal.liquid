{% comment %}
  Half horizontal — 800x240. Same grid as the full view, three rows.
{% endcomment %}

<style>
  .fx--halfh .fx-row,
  .fx--halfh .fx-head { grid-template-columns: 100px 130px 82px 170px 1fr; gap: 14px; }
  .fx--halfh .fx-row  { padding: 14px 0; }
  .fx--halfh .fx-pair { font-size: 16px; }
  .fx--halfh .fx-rate { font-size: 19px; }
  .fx--halfh .fx-chg  { font-size: 12px; }
  .fx--halfh .fx-range{ font-size: 9px; }
</style>

<div class="layout layout--col layout--justify-start">
  {% if fx_failed %}
    <div class="fx-error">
      <span class="title">Rates unavailable</span>
    </div>
  {% else %}
    <div class="fx-list fx--halfh">
      <div class="fx-head">
        <span></span><span>RATE</span><span>{{ range }}</span><span>TREND</span><span>LO / HI</span>
      </div>

      {% for row in rows limit: 3 %}
        <div class="fx-row">
          <div class="fx-pair">{{ row.from }}<span class="fx-arrow">&rarr;</span>{{ row.to }}</div>
          <div class="fx-rate">{{ row.rate }}</div>
          <div class="fx-chg">
            {% if row.change_pct >= 0 %}&#9650;{% else %}&#9660;{% endif %}
            {{ row.change_pct | abs }}%
          </div>
          <div class="fx-spark">
            {%- assign fx_xy = row.points | split: " " | last | split: "," -%}
            <svg viewBox="0 0 200 30" width="170" height="26" preserveAspectRatio="none">
              <polyline points="{{ row.points }}" vector-effect="non-scaling-stroke"/>
              <circle cx="{{ fx_xy[0] }}" cy="{{ fx_xy[1] }}" r="3"/>
            </svg>
          </div>
          <div class="fx-range">{{ row.lo }}<br/>{{ row.hi }}</div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Exchange Rates</span>
  <span class="instance">{{ range }} &middot; ECB {{ as_of }}</span>
</div>
