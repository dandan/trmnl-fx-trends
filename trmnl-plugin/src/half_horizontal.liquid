{% comment %}
  Half horizontal — 800x240. Same grid as the full view, three rows.
{% endcomment %}

{% comment %} TREND takes the free width; HI / LO sizes to content. See full.liquid. {% endcomment %}
{% comment %}
    11px, not 14: three rows plus the header and title_bar only just fit 240px
    on TRMNL OG, and the list now fills its container, so an overflow would
    push the last row under the title bar rather than leaving a gap.
  {% endcomment %}
{% comment %} Row inset is py--2.5 (10px) on the row: 11px would not step. {% endcomment %}
{% comment %} Half the panel height, 3 rows, 21px of row inset (2 x 10 + rule). {% endcomment %}
<style>
  .fx--halfh .fx-row,
  .fx--halfh .fx-head { grid-template-columns: 100px minmax(84px, auto) 64px 1fr minmax(50px, auto); gap: 14px; }
  .fx--halfh { --fx-top-pad: 8px; --fx-pair: 16px; --fx-rate: 19px; --fx-chg: 12px; --fx-range: 11px; --fx-head: 12px; }
  .fx--halfh .fx-dot  { r: 3.5px; }
  .fx--halfh .fx-spark svg { height: calc((var(--screen-h) / 2 - 82px - var(--fx-top-pad)) / 3 - 21px); }
</style>

<div class="layout layout--col layout--justify-start">
  {% if fx_failed %}
    <div class="fx-error flex flex--col flex--center-y text--center">
      <span class="title">Rates unavailable</span>
    </div>
  {% else %}
    <div class="fx-list flex flex--col gap--none pt--2 fx--halfh">
      <div class="fx-head grid pb--1">
        <span>PAIR</span><span class="text--right">LATEST</span><span class="text--right">CHANGE</span><span class="text--center">{% if range_label %}{{ range_label }} {% endif %}TREND</span><span class="text--right">HI / LO</span>
      </div>

      {% for row in rows limit: 3 %}
        <div class="fx-row grid py--2.5">
          <div class="fx-pair">{{ row.from }}<span class="fx-arrow px--0.5">&rarr;</span>{{ row.to }}</div>
            <div class="fx-rate text--right">{{ row.rate_str }}</div>
          <div class="fx-chg flex flex--right gap--none"><span class="fx-pill inline-block rounded--xsmall py--1 px--1.5{% if row.change_pct < 0 %} fx-pill--down bg--black text--white{% endif %}">{{ row.change_str }}%</span></div>
          {% assign fx_end = row.points | split: " " | last | split: "," %}
          {% assign fx_end_y = fx_end[1] | times: 100.0 | divided_by: 30 %}
          <div class="fx-spark flex gap--none">
            <svg class="fx-plot block" width="100%" height="26">
              <svg class="block" viewBox="0 0 200 30" width="100%" height="100%" preserveAspectRatio="none">
                <polyline points="{{ row.points }}" vector-effect="non-scaling-stroke"/>
              </svg>
              <circle class="fx-dot" cx="100%" cy="{{ fx_end_y }}%"/>
            </svg>
          </div>
          <div class="fx-range flex flex--col flex--between gap--none text--right"><span>{{ row.hi_str }}</span><span>{{ row.lo_str }}</span></div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<div class="title_bar">
  {{ fx_icon }}
  <span class="title">Exchange Rates{% if env %} ({{ env | upcase }}){% endif %}</span>
  <span class="instance">{% if fx_failed %}No data{% else %}<span class="fx-dates text--default">{{ fx_dates }}</span> &middot; ECB{% endif %}</span>
</div>
