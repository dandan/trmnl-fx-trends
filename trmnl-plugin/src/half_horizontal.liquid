{% comment %}
  Half horizontal — 800x240 on an OG. Same grid as the full view, three rows,
  one tier down on every column.
{% endcomment %}

{% comment %} TREND takes the free width; HI / LO sizes to content. See full.liquid. {% endcomment %}
{% comment %}
    Three rows plus the header and title_bar only just fit 240px on TRMNL OG,
    and the list fills its container, so an overflow would push the last row
    under the title bar rather than leaving a gap. The rate is `value--small`,
    a 29px line box, and the row inset `py--2.5` (10px): 3 x (29 + 20 + 1)
    under ~90px of chrome lands on the panel to the pixel. The X steps every
    tier up one (`lg:`) and, at half of 780px, has the height to spare.
  {% endcomment %}
{% comment %}
  Half the panel height, 3 rows, 21px of row inset (2 x 10 + rule). The chrome
  term is 8px more on the X, where the header is the 16px `label` tier; see
  full.liquid for the terms.
{% endcomment %}
<style>
  .fx--halfh .fx-row,
  .fx--halfh .fx-head { grid-template-columns: 106px minmax(142px, auto) 64px 1fr minmax(64px, auto); gap: 14px; }
  .screen--lg .fx--halfh .fx-row,
  .screen--lg .fx--halfh .fx-head { grid-template-columns: 140px minmax(208px, auto) 92px 1fr minmax(88px, auto); }
  .fx--halfh { --fx-top-pad: 8px; --fx-chrome: 82px; --fx-inset: 21px; }
  .screen--lg .fx--halfh { --fx-chrome: 90px; }
  .fx--halfh .fx-dot  { r: 3.5px; }
  .screen--lg .fx--halfh .fx-dot { r: 4.5px; }
  .fx--halfh .fx-spark svg { height: calc((var(--screen-h) / 2 - var(--fx-chrome) - var(--fx-top-pad)) / 3 - var(--fx-inset)); }
</style>

<div class="layout layout--col layout--justify-start">
  {% if fx_failed %}
    <div class="fx-error flex flex--col flex--center-y text--center">
      <span class="title">Rates unavailable</span>
    </div>
  {% else %}
    <div class="fx-list flex flex--col gap--none pt--2 fx--halfh">
      <div class="fx-head grid pb--1">
        <span class="label label--small text--bold lg:label--base">PAIR</span><span class="label label--small text--bold lg:label--base text--right">LATEST</span><span class="label label--small text--bold lg:label--base text--right">CHANGE</span><span class="label label--small text--bold lg:label--base text--center">{% if range_label %}{{ range_label }} {% endif %}TREND</span><span class="label label--small text--bold lg:label--base text--right">HI / LO</span>
      </div>

      {% for row in rows limit: 3 %}
        <div class="fx-row grid py--2.5">
          <div class="fx-pair value value--xsmall text--bold lg:value--small">{{ row.from }}<span class="fx-arrow text--regular px--0.5">&rarr;</span>{{ row.to }}</div>
          <div class="fx-rate value value--small value--tnums text--bold lg:value--base text--right">{{ row.rate_str }}</div>
          <div class="fx-chg flex flex--right gap--none"><span class="label text--bold lg:label--large {% if row.change_pct < 0 %}label--filled{% else %}label--outline{% endif %}">{{ row.change_str }}%</span></div>
          {% assign fx_end = row.points | split: " " | last | split: "," %}
          {% assign fx_end_y = fx_end[1] | times: 100.0 | divided_by: 30 %}
          <div class="fx-spark flex gap--none">
            <svg class="fx-plot block" width="100%" height="26">
              <svg class="block" viewBox="0 0 200 30" width="100%" height="100%" preserveAspectRatio="none">
                <polyline points="{{ row.points }}" vector-effect="non-scaling-stroke"/>
              </svg>
              <circle class="fx-dot" cx="100%" cy="{{ fx_end_y }}%"/>
            </svg>
          </div>
          <div class="fx-range flex flex--col flex--between gap--none text--right"><span class="label label--small value--tnums lg:label--base">{{ row.hi_str }}</span><span class="label label--small value--tnums lg:label--base">{{ row.lo_str }}</span></div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<div class="title_bar">
  {{ fx_icon }}
  <span class="title">Exchange Rates{% if env %} ({{ env | upcase }}){% endif %}</span>
  <span class="instance">{% if fx_failed %}No data{% else %}<span class="fx-dates text--default">{{ fx_dates }}</span> &middot; ECB{% endif %}</span>
</div>
