{% comment %}
  Half horizontal — 800x240. Same grid as the full view, three rows.
{% endcomment %}

<style>
  {% comment %} TREND takes the free width; HI / LO sizes to content. See full.liquid. {% endcomment %}
  .fx--halfh .fx-row,
  .fx--halfh .fx-head { grid-template-columns: 100px minmax(84px, auto) 82px 1fr minmax(50px, auto); gap: 14px; }
  {% comment %}
    11px, not 14: three rows plus the header and title_bar only just fit 240px
    on TRMNL OG, and the list now fills its container, so an overflow would
    push the last row under the title bar rather than leaving a gap.
  {% endcomment %}
  .fx--halfh { --fx-top-pad: 8px; }
  .fx--halfh .fx-row  { padding: 11px 0; }
  .fx--halfh .fx-pair { font-size: 16px; }
  .fx--halfh .fx-rate { font-size: 19px; }
  .fx--halfh .fx-chg  { font-size: 12px; }
  .fx--halfh .fx-range{ font-size: 11px; }
  {% comment %} Half the panel height, 3 rows, 23px row padding. {% endcomment %}
  .fx--halfh .fx-spark svg { height: calc((var(--screen-h) / 2 - 82px - var(--fx-top-pad)) / 3 - 23px); }
</style>

<div class="layout layout--col layout--justify-start">
  {% if fx_failed %}
    <div class="fx-error">
      <span class="title">Rates unavailable</span>
    </div>
  {% else %}
    <div class="fx-list fx--halfh">
      <div class="fx-head">
        <span></span><span>LATEST</span><span>CHANGE</span><span>TREND</span><span>HI / LO</span>
      </div>

      {% for row in rows limit: 3 %}
        <div class="fx-row">
          <div class="fx-pair">{{ row.from }}<span class="fx-arrow">&rarr;</span>{{ row.to }}</div>
            <div class="fx-rate">{{ row.rate_str }}</div>
          <div class="fx-chg">
            {% if row.change_pct >= 0 %}&#9650;{% else %}&#9660;{% endif %}
            {{ row.change_pct | abs }}%
          </div>
          <div class="fx-spark">
            {%- assign fx_xy = row.points | split: " " | last | split: "," -%}
            <svg viewBox="0 0 200 30" width="100%" height="26" preserveAspectRatio="none">
              <polyline points="{{ row.points }}" vector-effect="non-scaling-stroke"/>
              <line x1="{{ fx_xy[0] }}" y1="{{ fx_xy[1] | minus: 3 }}" x2="{{ fx_xy[0] }}" y2="{{ fx_xy[1] | plus: 3 }}" vector-effect="non-scaling-stroke"/>
            </svg>
          </div>
          <div class="fx-range"><span>{{ row.hi_str }}</span><span>{{ row.lo_str }}</span></div>
        </div>
      {% endfor %}
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Exchange Rates</span>
  <span class="instance">{% if fx_failed %}No data{% else %}{{ range_label }} &middot; ECB {{ as_of }}{% endif %}</span>
</div>
