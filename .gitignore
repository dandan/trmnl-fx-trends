# Secrets and per-account deploy profiles.
# NOTE: gitignore only treats '#' as a comment at the START of a line — a
# trailing comment becomes part of the pattern and silently matches nothing.
# Keep every comment on its own line.

# wrangler dev's local vars
.dev.vars

# retired: the Worker's bearer token, dropped when the plugin became
# publishable. Still ignored so an old local copy can't be committed by mistake.
.prod.vars

# per-account TRMNL deploy profiles
.env.*
!.env.example
