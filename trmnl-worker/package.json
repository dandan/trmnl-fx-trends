{
  "name": "exchange-rates-trmnl-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker serving plot-ready exchange-rate sparkline data as JSON for a TRMNL plugin.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:qa": "wrangler deploy --env qa",
    "tail:qa": "wrangler tail --env qa",
    "tail": "wrangler tail",
    "test": "node --test \"tests/*.test.js\"",
    "smoke": "node tests/smoke.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
